# Backend di ron1nOS. Copia in .env per npm run dev:server; sul server le
# stesse variabili stanno nel .env dello stack infra/ron1nos.
PORT=8080

# Web API di qBittorrent (stack infra/torrent). Le credenziali restano sul
# server: i client non le vedono mai. In sviluppo si può usare il finto
# degli e2e: node e2e/fake-qbittorrent.ts (porta 18080, admin/admin).
QBT_URL=http://localhost:18080
QBT_USERNAME=admin
QBT_PASSWORD=admin

# Secondi di attesa dei metadati di un magnet prima di proporre Riprova.
# METADATA_WAIT_SECONDS=60

# API di Glances (stack infra/glances, rete host) per il modulo Server. In
# sviluppo: node e2e/fake-glances.ts (porta 18081).
GLANCES_URL=http://localhost:18081

# Postgres del modulo Nutrizione: database ron1nos nel Postgres condiviso
# del server (stack infra/postgres di ron1n). Le migrazioni si applicano
# all'avvio. In sviluppo: il container del README.
DATABASE_URL=postgres://ron1nos:ron1nos@localhost:5432/ron1nos

# Account YAZIO per il modulo Nutrizione (NUT-020…024). Senza tutte queste
# variabili la sincronizzazione resta spenta e il diario vive solo qui.
# Serve un account con email e password: se entri con Apple o Google,
# imposta prima una password nell'app YAZIO. Usa una password solo per YAZIO.
# YAZIO_USERNAME=
# YAZIO_PASSWORD=
# Chiavi pubbliche dell'app YAZIO (non sono nostre): se YAZIO le cambia
# con un aggiornamento dell'app, si aggiornano qui.
# YAZIO_CLIENT_ID=1_4hiybetvfksgw40o0sog4s884kwc840wwso8go4k8c04goo4c
# YAZIO_CLIENT_SECRET=6rok2m65xuskgkgogw40wkkk8sw0osg84s8cggsc4woos4s8o
# Chiave con cui il backend cifra i token di YAZIO in Postgres: una frase
# lunga e casuale (es. openssl rand -base64 32). Se cambia, rifà il login.
# YAZIO_TOKEN_KEY=
# YAZIO_URL=https://yzapi.yazio.com/v20
